	<ItemGroup>
		<ProjectReference Include="..\StoneAssemblies.Blazor.MVVM\StoneAssemblies.Blazor.MVVM.csproj" />
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="Fody" Version="6.8.1">
	    <PrivateAssets>all</PrivateAssets>
	    <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
	  </PackageReference>
	  <PackageReference Update="Serilog" Version="4.0.1" />
	</ItemGroup>
</Project>
